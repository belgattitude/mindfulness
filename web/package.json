{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "files": [
    "env.mjs",
    "next.config.mjs",
    "dist",
    "public"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --bun run next dev",
    "?dev-no-tls": "Disable node tls verifications in dev. So we can use self-signed certs",
    "dev-no-tls": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 bun --bun run next dev",
    "build": "bun --bun run next build",
    "build-fast": "cross-env NEXTJS_IGNORE_TYPECHECK=1 bun --bun run next build",
    "typegen": "next typegen",
    "start": "next start",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test-unit": "vitest run",
    "typecheck": "next typegen && tsc --project ./tsconfig.json --noEmit",
    "clean": "rimraf ./.next ./out ./coverage ./tsconfig.tsbuildinfo .cache ./node_modules/.cache storybook-static",
    "codegen": "orval --config orval.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "nuke:node_modules": "rimraf --glob '**/node_modules'"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@httpx/assert": "0.18.0",
    "@httpx/exception": "4.1.0",
    "@httpx/plain-object": "2.3.0",
    "@strapi/blocks-react-renderer": "1.0.2",
    "@t3-oss/env-core": "0.13.11",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.104.5",
    "@vercel/og": "1.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dayjs": "1.11.23",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-secure-headers": "2.2.0",
    "nodemailer": "10.2.1",
    "qs": "6.16.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-google-recaptcha-v3": "1.11.0",
    "react-twc": "1.5.1",
    "remark": "15.0.1",
    "remark-html": "16.0.1",
    "rooks": "9.9.0",
    "shadcn": "4.22.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-links": "10.6.3",
    "@storybook/addon-themes": "10.6.3",
    "@storybook/nextjs-vite": "10.6.3",
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/qs": "6.15.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "dotenv-flow-cli": "1.1.1",
    "orval": "8.44.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tailwindcss": "1.16.0",
    "postcss": "8.5.31",
    "rimraf": "6.1.3",
    "storybook": "10.6.3",
    "style-loader": "4.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "8.0.2",
    "vite": "8.3.5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  }
}
