{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "files": [
    "env.mjs",
    "next.config.mjs",
    "dist",
    "public"
  ],
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "?dev-no-tls": "Disable node tls verifications in dev. So we can use self-signed certs",
    "dev-no-tls": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 next dev",
    "build": "next build",
    "build-fast": "cross-env NEXTJS_IGNORE_TYPECHECK=1 next build --no-lint",
    "typegen": "next typegen",
    "start": "next start",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test-unit": "vitest run",
    "typecheck": "next typegen && tsc --project ./tsconfig.json --noEmit",
    "clean": "rimraf ./.next ./out ./coverage ./tsconfig.tsbuildinfo .cache ./node_modules/.cache storybook-static",
    "codegen-schema": "dotenv-flow -- yarn graphql-codegen --config codegen.schema-ast.ts",
    "codegen": "dotenv-flow -- yarn graphql-codegen --config codegen.ts",
    "codegen-watch": "dotenv-flow -- yarn graphql-codegen --config codegen.ts --watch",
    "deps:check": "npx npm-check-updates@latest --configFileName .ncurc.yml",
    "deps:update": "npx npm-check-updates@latest --configFileName .ncurc.yml -u",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "nuke:node_modules": "rimraf --glob '**/node_modules'"
  },
  "dependencies": {
    "@httpx/assert": "0.18.0",
    "@httpx/exception": "3.2.0",
    "@httpx/plain-object": "2.2.0",
    "@t3-oss/env-core": "0.13.11",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.104.1",
    "@vercel/og": "1.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dayjs": "1.11.23",
    "graphql": "17.0.2",
    "graphql-request": "7.4.0",
    "next": "16.4.0",
    "next-secure-headers": "2.2.0",
    "nodemailer": "10.0.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-google-recaptcha-v3": "1.11.0",
    "react-markdown": "10.1.0",
    "react-twc": "1.5.1",
    "rehype-external-links": "3.0.0",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-html": "16.0.1",
    "rooks": "9.9.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@graphql-codegen/cli": "7.4.5",
    "@graphql-codegen/client-preset": "6.2.2",
    "@graphql-codegen/typescript": "6.1.1",
    "@graphql-codegen/typescript-react-query": "7.0.5",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-links": "10.6.1",
    "@storybook/addon-themes": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "css-loader": "7.1.5",
    "dotenv-flow-cli": "1.1.1",
    "graphql-config": "5.1.8",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tailwindcss": "1.14.0",
    "postcss": "8.5.29",
    "postcss-loader": "8.2.1",
    "rimraf": "6.1.3",
    "storybook": "10.6.1",
    "style-loader": "4.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.12.4",
    "vite": "8.3.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.3",
    "webpack": "5.111.1"
  },
  "packageManager": "yarn@4.18.0"
}
