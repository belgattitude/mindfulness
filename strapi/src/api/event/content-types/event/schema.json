{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "minLength": 15,
      "maxLength": 255,
      "required": true,
      "unique": true
    },
    "summary": {
      "type": "text",
      "maxLength": 1024
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "universe": {
      "type": "enumeration",
      "required": false,
      "enum": [
        "yoga",
        "meditation",
        "dialogue"
      ]
    },
    "description": {
      "type": "blocks",
      "required": true
    },
    "startDate": {
      "type": "date",
      "required": true
    },
    "startTime": {
      "type": "time"
    },
    "endDate": {
      "type": "date",
      "required": true
    },
    "endTime": {
      "type": "time"
    },
    "flyer": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "videos",
        "files"
      ]
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "displayTitle": {
      "type": "string",
      "minLength": 10,
      "maxLength": 140
    },
    "location": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "online"
            },
            false
          ]
        }
      },
      "minLength": 3,
      "maxLength": 100
    },
    "organizers": {
      "type": "string",
      "minLength": 3,
      "maxLength": 150
    },
    "online": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "facebookLink": {
      "type": "string",
      "minLength": 10,
      "maxLength": 255,
      "regex": "https://"
    },
    "programmes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::programme.programme",
      "mappedBy": "events"
    },
    "eventType": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "stages-et-retraites",
        "cours-reguliers",
        "programmes-et-cycles",
        "atelier-ponctuel"
      ]
    },
    "link": {
      "type": "string",
      "minLength": 10,
      "maxLength": 160,
      "regex": "^(https?:)?(//)?([\\da-z.-]+)\\.([a-z.]{2,6})([/\\w .-]*)*/?$"
    },
    "registrationFormUrl": {
      "type": "string",
      "minLength": 10,
      "maxLength": 180,
      "regex": "^(https?:)?(//)?([\\da-z.-]+)\\.([a-z.]{2,6})([/\\w .-]*)*/?$"
    }
  }
}
