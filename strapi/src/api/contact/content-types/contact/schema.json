{
  "kind": "singleType",
  "collectionName": "contacts",
  "info": {
    "singularName": "contact",
    "pluralName": "contacts",
    "displayName": "Contact",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "text"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "description": {
      "type": "blocks"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "whatsapp": {
      "type": "boolean",
      "default": true
    },
    "linkedin": {
      "type": "string",
      "regex": "^https://"
    }
  }
}
