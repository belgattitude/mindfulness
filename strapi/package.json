{
  "name": "mindfulness-strapi",
  "private": true,
  "version": "0.1.0",
  "description": "Mindfulness website",
  "scripts": {
    "develop": "strapi develop",
    "start": "strapi start",
    "build": "strapi build",
    "strapi": "strapi",
    "deps:check": "npx npm-check-updates@latest --configFileName .ncurc.yml",
    "deps:update": "npx npm-check-updates@latest --configFileName .ncurc.yml -u",
    "clean": "rimraf .cache build node_modules/.cache",
    "nuke:node_modules": "rimraf --glob '**/node_modules'",
    "docker:build": "docker compose build",
    "deploy": "node scripts/deploy.mts",
    "backup:db": "node scripts/backup.mts db",
    "backup:env": "node scripts/backup.mts env",
    "copy-remote-uploads": "node scripts/copy-remote-uploads.mts",
    "typecheck": "tsc -p scripts"
  },
  "dependencies": {
    "@strapi/plugin-documentation": "5.57.0",
    "@strapi/plugin-graphql": "5.57.0",
    "@strapi/plugin-users-permissions": "5.57.0",
    "@strapi/provider-email-nodemailer": "5.57.0",
    "@strapi/strapi": "5.57.0",
    "better-sqlite3": "12.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.30.0",
    "@types/node": "24.13.6",
    "execa": "10.0.1",
    "rimraf": "6.1.3",
    "typescript": "7.0.2"
  },
  "author": {
    "name": "Sébastien Vanvelthem"
  },
  "strapi": {
    "uuid": "ef7a525d-01bc-487a-bbe8-0dfaeb05faaa"
  },
  "engines": {
    "node": ">=24.21"
  },
  "packageManager": "yarn@4.18.1",
  "license": "MIT"
}
