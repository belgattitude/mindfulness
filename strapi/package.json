{
  "name": "mindfulness-strapi",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Mindfulness website",
  "scripts": {
    "develop": "bun --bun run strapi develop",
    "start": "bun --bun run strapi start",
    "build": "strapi build",
    "strapi": "strapi",
    "deps:check": "npx npm-check-updates@latest --configFileName .ncurc.yml",
    "deps:update": "npx npm-check-updates@latest --configFileName .ncurc.yml -u",
    "clean": "rimraf .cache build node_modules/.cache",
    "nuke:node_modules": "rimraf --glob '**/node_modules'",
    "docker:build": "docker compose build",
    "deploy": "node scripts/deploy.mts",
    "backup:db": "node scripts/backup.mts db",
    "backup:env": "node scripts/backup.mts env",
    "copy-remote-uploads": "node scripts/copy-remote-uploads.mts",
    "pull:prod": "node scripts/pull-prod.mts",
    "push:prod": "node scripts/push-prod.mts",
    "migrate:blocks": "node scripts/migrate-markdown-to-blocks.mts",
    "typecheck": "tsc -p scripts"
  },
  "dependencies": {
    "@strapi/plugin-documentation": "5.59.0",
    "@strapi/plugin-users-permissions": "5.59.0",
    "@strapi/provider-email-nodemailer": "5.59.0",
    "@strapi/strapi": "5.59.0",
    "better-sqlite3": "13.0.3",
    "heic-decode": "2.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sharp": "0.35.5",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.38.2",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "execa": "10.2.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "rimraf": "6.1.3",
    "typescript": "7.0.2"
  },
  "author": {
    "name": "Sébastien Vanvelthem"
  },
  "strapi": {
    "uuid": "ef7a525d-01bc-487a-bbe8-0dfaeb05faaa"
  },
  "engines": {
    "node": ">=24.21"
  },
  "license": "MIT"
}
