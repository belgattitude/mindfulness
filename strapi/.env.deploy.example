# Copy to .env.deploy (git ignored) and fill in, used by `pnpm run deploy` and `pnpm backup:*`
# Loaded with dotenvx: values can be encrypted with `pnpm dotenvx encrypt -f .env.deploy`,
# the private key is then stored in the OS keychain (or set DOTENV_PRIVATE_KEY_DEPLOY)

# SSH access to the server, user@host or an alias from ~/.ssh/config
# For deploy, the user must be root or in the docker group
REMOTE_SSH=user@1.2.3.4
# Optional, when ssh does not listen on 22
#REMOTE_SSH_PORT=2222
# Optional, when the key is not loaded in the ssh agent (path without spaces)
#REMOTE_SSH_KEY=~/.ssh/id_ed25519

# Directory on the server holding docker-compose.yml (uploaded by `pnpm run deploy`)
# and .env (strapi secrets, never deployed, backed up by `pnpm backup:env`)
DEPLOY_DIR=/home/sebastien/mindfulness2
# Optional, previous commit tags kept on the server for rollbacks (default 3)
#DEPLOY_KEEP_IMAGES=3

# Database backups (`pnpm backup:db`) into backup/database/<timestamp>/
BACKUP_REMOTE_SQLITE_DIR=/mnt/volume-1/mindfulness/sqlite

# Uploads copied into the local public/uploads (`pnpm copy-remote-uploads`)
REMOTE_UPLOADS_DIR=/mnt/volume-1/mindfulness/uploads
